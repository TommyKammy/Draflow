      "to": {
        "node": "register",
        "port": "main",
        "index": 0
      }
    },
    {
      "id": "register-return",
      "from": {
        "node": "register",
        "port": "main",
        "index": 0
      },
      "to": {
        "node": "return",
        "port": "main",
        "index": 0
