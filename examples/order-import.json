  ],
  "settings": {},
  "connections": [
    {
      "id": "schedule-pages",
      "from": {
        "node": "schedule",
        "port": "main",
        "index": 0
      },
      "to": {
        "node": "pages",
        "port": "main",
        "index": 0
      }
    }
  ]
