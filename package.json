{
  "name": "draflow",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm --filter @draflow/demo build",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json && tsc -p apps/demo/tsconfig.json && tsc -p apps/demo/consumer/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size-report.mjs",
    "dev": "tsc -b tsconfig.json && pnpm --filter @draflow/demo dev",
    "test:browser": "playwright test",
    "bench:expression": "node apps/demo/bench/expression.mjs",
    "bench:canvas": "playwright test -c playwright.bench.config.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^3.2.4",
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2"
  }
}
